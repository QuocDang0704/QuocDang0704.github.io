source "https://rubygems.org"

# Trang này deploy bằng GitHub Pages nên dùng gem github-pages
# để khớp phiên bản Jekyll + plugin mà GitHub Pages hỗ trợ.
gem "github-pages", "~> 228", group: :jekyll_plugins

# Plugins
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
end

# Windows & JRuby không có sẵn zoneinfo, cần tzinfo
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Tăng tốc theo dõi thư mục trên Windows
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]

gem "webrick", "~> 1.8"
